{
  "extends": "./tsconfig.json",
  "include": ["vite.config.ts", "vite.harness.config.ts", "vitest.config.ts", "react-router.config.ts", "scripts/**/*", "app/lib/editor/*.mjs", "www/*.mjs", "workers/security-headers.ts"],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
