{
  "name": "carrel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc -b",
    "test": "vitest run && node scripts/check-deploy.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:postinstall": "node scripts/check-postinstall.mjs",
    "check:mcp-roles": "node scripts/check-mcp-roles.mjs",
    "check:conformance": "node scripts/check-conformance.mjs",
    "check:plants": "node scripts/plant-gates.mjs",
    "check:bloat": "node scripts/check-bloat.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:owner": "node scripts/seed-owner.mjs",
    "import:docx": "node scripts/import-docx.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "node scripts/deploy.mjs",
    "postinstall": "node scripts/bootstrap-config.mjs",
    "lint:promises": "eslint app workers test",
    "check:a11y": "node scripts/check-a11y.mjs",
    "harness": "vite build --config vite.harness.config.ts && vite preview --config vite.harness.config.ts --port 5199 --host 127.0.0.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.5.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.4.0",
    "diff": "9.0.0",
    "docx": "9.7.2",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "isbot": "^5.1.31",
    "jose": "^6.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/vitest-plugin": "1.2.8",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.2.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@react-router/dev": "8.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.1.3",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  }
}
