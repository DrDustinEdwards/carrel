{
  "name": "carrel",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only -- --strict-vars=false && react-router typegen && tsc -b",
    "test": "vitest run && node scripts/check-deploy.mjs && node scripts/check-verify-live.mjs && node scripts/check-repo-name.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:verify-live": "node scripts/check-verify-live.mjs",
    "check:postinstall": "devkit-bootstrap --check",
    "check:mcp-roles": "node scripts/check-mcp-roles.mjs",
    "check:conformance": "devkit-conformance",
    "check:plants": "node scripts/plant-gates.mjs",
    "check:bloat": "devkit-no-bloat --warn-only && npm run build && devkit-route-weight",
    "check:roundtrip": "node scripts/check-roundtrip.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:owner": "node scripts/seed-owner.mjs",
    "import:docx": "node scripts/import-docx.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "node scripts/deploy.mjs",
    "postinstall": "devkit-bootstrap -- --strict-vars=false",
    "lint:promises": "eslint app workers test",
    "check:a11y": "node scripts/check-a11y.mjs",
    "harness": "vite build --config vite.harness.config.ts && vite preview --config vite.harness.config.ts --port 5199 --host 127.0.0.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.6.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.8.1",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.12.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "agents": "0.29.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.15.1",
    "diff": "9.0.0",
    "docx": "9.7.2",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "isbot": "5.2.2",
    "jose": "6.2.12",
    "mdast-util-directive": "3.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.11.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@react-router/dev": "8.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
