{
  "name": "carrel",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "headers": "site-runtime-headers --site carrel-desk --out public/_headers",
    "dev": "react-router dev",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "devkit-bootstrap --types-only -- --strict-vars=false && react-router typegen && tsc -b",
    "test": "vitest run && node scripts/check-deploy.mjs && node scripts/check-verify-live.mjs && node scripts/check-repo-name.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:verify-live": "node scripts/check-verify-live.mjs",
    "check:postinstall": "devkit-bootstrap --check",
    "check:mcp-roles": "node scripts/check-mcp-roles.mjs",
    "check:conformance": "devkit-conformance",
    "check:secrets": "devkit-secrets",
    "check:destructive": "devkit-destructive",
    "check:plants": "node scripts/plant-gates.mjs",
    "check:bloat": "devkit-no-bloat && npm run build && devkit-route-weight",
    "check:roundtrip": "capsomer-roundtrip",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations drizzle --min 29",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:owner": "node scripts/seed-owner.mjs",
    "import:docx": "node scripts/import-docx.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "node scripts/deploy.mjs",
    "www": "node www/build.mjs && prelum-lastmod --dir www/dist --origin https://carrel.dustinedwards.info",
    "deploy:www": "npm run www && wrangler deploy -c www/wrangler.jsonc",
    "postinstall": "devkit-bootstrap -- --strict-vars=false",
    "check:a11y": "node scripts/check-a11y.mjs",
    "harness": "vite build --config vite.harness.config.ts && vite preview --config vite.harness.config.ts --port 5199 --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.61.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.16.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.42.1",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.159.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@handlewithcare/prosemirror-suggest-changes": "0.1.8",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@observablehq/plot": "0.6.19",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-collaboration": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/y-tiptap": "3.3.0",
    "agents": "0.33.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.152.1",
    "docx": "9.15.3",
    "drizzle-orm": "0.45.4",
    "enarratio": "0.15.0",
    "fflate": "0.8.3",
    "isbot": "5.2.3",
    "lib0": "0.2.120",
    "linkedom": "0.18.15",
    "mdast-util-directive": "3.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-math": "3.0.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "partyserver": "0.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "y-partyserver": "2.2.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.51.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hast-util-from-html": "2.1.0",
    "hast-util-to-mdast": "10.1.2",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "@cloudflare/workers-types": "5.20261110.1"
  },
  "engines": {
    "node": ">=26.11.1"
  }
}
