/**
 * Wrangler configuration template for Carrel.
 *
 * `scripts/bootstrap-config.mjs` copies this to wrangler.jsonc on install and never overwrites it.
 * The real file is gitignored because it carries the D1 database id. Secrets are set with
 * `wrangler secret put`, never here: ACCESS_AUD (the AUD tag of the Worker's Access application),
 * ACCESS_SAAS_CLIENT_ID and ACCESS_SAAS_CLIENT_SECRET (the AI door's Access for SaaS login), and one
 * key per site, SITE_DUSTINEDWARDS_KEY, SITE_GERMOMICS_KEY, SITE_FOXHOUND_KEY, SITE_FOXING_KEY,
 * SITE_TXASM_KEY and SITE_JULIEEDWARDS_KEY (absent until the site is connected).
 *
 * NEVER PUBLIC, BY DEPLOY ORDER. desk.dustinedwards.info has a hostname Access application (not
 * Worker-level Access, which refuses WebSockets and so the co-editing rooms: docs/coediting.md), and
 * workers/gate.ts refuses any request without its token. So the first deploy has no route at all,
 * workers_dev and preview_urls are false, the Access application is made, and only then is the
 * custom domain added by uncommenting `routes` below. Setting
 * workers_dev and preview_urls here, not in the dashboard, means a deploy cannot turn them back on.
 *
 * ACCESS_TEAM_DOMAIN is the Zero Trust team domain, the issuer of every Access token. It lives in
 * config, not code, so a rename of the team is a config change.
 *
 * THE AI DOOR IS THE ONE EXCEPTION, by hostname. carrel-mcp.dustinedwards.info must be reachable
 * before anyone signs in, because an MCP client fetches the OAuth metadata and token endpoints there.
 * So it gets a hostname Access application with a Bypass policy, of its own. Carrel's own OAuth provider guards /mcp there instead, with Access for
 * SaaS as its login. Add that Bypass app BEFORE uncommenting the second route below.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "carrel-desk",
	// Cloudflare says to set this to today's date. It is the newest date the pinned workerd accepts (a
	// newer one stops the local runtime and the tests from starting); raise it with wrangler.
	"compatibility_date": "2026-10-02",
	"main": "./workers/app.ts",
	// global_fetch_strictly_public: the AI door's OAuth provider refuses to fetch a client's metadata
	// document (CIMD) without it, as SSRF protection. It also sends same-zone fetches (the site API on
	// dustinedwards.info) through the public front door, as a browser's would go.
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	// Uncomment only after Desk's Access application exists (setup step 7), and the second route only after
	// the carrel-mcp hostname's Bypass application exists.
	// "routes": [
	// 	{
	// 		"pattern": "desk.dustinedwards.info",
	// 		"custom_domain": true
	// 	},
	// 	{
	// 		"pattern": "carrel-mcp.dustinedwards.info",
	// 		"custom_domain": true
	// 	}
	// ],
	// Logs and traces both on, at a stated rate. 1 keeps every request: Carrel is one person's tool, so
	// the volume is small and a sampled-away failure is the cost that matters. invocation_logs stays
	// off; the code writes its own structured JSON lines (console.warn(JSON.stringify({...}))).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	// The first runs every 15 minutes (health, refresh, inbox, social). The second is the nightly D1 dump
	// into BACKUPS (app/lib/backup.server.ts); it runs the dump alone. Its text is pinned by
	// BACKUP_CRON in app/lib/backup-checks.ts and by test/backup.test.ts.
	"triggers": {
		"crons": ["*/15 * * * *", "17 3 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "carrel",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	// Grants and tokens for the AI door's OAuth provider: `npx wrangler kv namespace create OAUTH_KV`,
	// then its id here.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	// Nightly D1 dumps (d1-dump), under backups/json/. Carrel's own bucket: `npx wrangler r2 bucket create carrel-backups`.
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "carrel-backups"
		}
	],
	// One room per open file for live co-editing (workers/doc-room.ts, y-partyserver): the shared working
	// copy, who is in it and the comments, in each object's own SQLite storage. Nothing reaches a room but
	// the browser door, behind Access.
	"durable_objects": {
		"bindings": [
			{
				"name": "DOC_ROOM",
				"class_name": "DocRoom"
			},
			// The AI door's limit per person (site-runtime's checkRateLimit, 30 requests a minute).
			{
				"name": "MCP_RATE_LIMIT",
				"class_name": "RateLimiter"
			},
			// The append-only tool-call log (site-runtime's ToolCallLog): refused, started, finished.
			{
				"name": "TOOL_CALL_LOG",
				"class_name": "ToolCallLog"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-doc-room",
			"new_sqlite_classes": ["DocRoom"]
		},
		{
			"tag": "v2-mcp-door",
			"new_sqlite_classes": ["RateLimiter", "ToolCallLog"]
		}
	],
	// The AI door's CSP report sink (workers/csp-report.ts): at most 60 report requests a minute from one
	// address reach the log. namespace_id is this Worker's own: sites sharing one share counters.
	"ratelimits": [
		{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7703", "simple": { "limit": 60, "period": 60 } }
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "https://dustinedwards.cloudflareaccess.com",
		"ALERT_EMAIL": "alerts@example.com",
		"ALERT_FROM": "carrel@dustinedwards.info",
		// Capsid, where the cron reports the AI drafts waiting for review (POST /ops/inbox/report).
		"CAPSID_ORIGIN": "https://mcp.dustinedwards.info",
		// Where Carrel's pages live, for links in email.
		"CARREL_ORIGIN": "https://desk.dustinedwards.info",
		// The AI door: OAuth and /mcp, and nothing else. Its hostname alone marks a request as AI.
		"CARREL_MCP_ORIGIN": "https://carrel-mcp.dustinedwards.info",
		// Callbacks a self-registering AI client (Grok, Gemini) may name beyond the fixed ones in
		// app/lib/mcp/registration.ts, each exact and https, separated by spaces: ChatGPT's
		// per-connector https://chatgpt.com/connector/oauth/<id>, the Gemini app's per-user callback.
		"DCR_REDIRECT_URIS": "",
		// The Drive folder Dustin shares with the service account (the id in its URL). Stage 6.
		"GOOGLE_MANUSCRIPTS_FOLDER_ID": "",
		// The Search Console property for dustinedwards.info, if it is not the domain property.
		"SEARCH_CONSOLE_PROPERTY_DUSTINEDWARDS": "sc-domain:dustinedwards.info",
		"SEARCH_CONSOLE_PROPERTY_GERMOMICS": "sc-domain:germomics.com",
		"SEARCH_CONSOLE_PROPERTY_FOXHOUND": "sc-domain:foxhoundapp.com",
		"SEARCH_CONSOLE_PROPERTY_FOXING": "sc-domain:foxing.app",
		"SEARCH_CONSOLE_PROPERTY_TXASM": "sc-domain:txasm.org",
		"SEARCH_CONSOLE_PROPERTY_JULIEEDWARDS": "sc-domain:julieedwards.info",
		// The site Carrel reaches through site-api. Its key is the secret SITE_DUSTINEDWARDS_KEY.
		"SITE_DUSTINEDWARDS_ORIGIN": "https://dustinedwards.info",
		// germomics, served by its own Worker at this domain. Its key is the secret SITE_GERMOMICS_KEY.
		"SITE_GERMOMICS_ORIGIN": "https://germomics.com",
		// Foxhound's blog, served by its own Worker at this domain. Its key is the secret SITE_FOXHOUND_KEY.
		"SITE_FOXHOUND_ORIGIN": "https://foxhoundapp.com",
		// Foxing's Journal, served by its own Worker at this domain. Its key is the secret SITE_FOXING_KEY.
		"SITE_FOXING_ORIGIN": "https://foxing.app",
		// txasm's two site pages, served by its own Worker at this domain. Its key is the secret SITE_TXASM_KEY.
		"SITE_TXASM_ORIGIN": "https://txasm.dustin-edwards.workers.dev",
		// julieedwards.info's sections, served at this domain. Its key is the secret SITE_JULIEEDWARDS_KEY.
		"SITE_JULIEEDWARDS_ORIGIN": "https://julieedwards.info"
	}
}
