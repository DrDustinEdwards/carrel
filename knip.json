{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "entry": [
    "scripts/*.mjs",
    "www/build.mjs",
    "www/worker.mjs",
    "test/**/*.test.ts",
    "test/entry.ts",
    "test/conformance/*entry.ts",
    "test/harness/*.ts"
  ],
  "ignoreDependencies": [
    "cloudflare",
    "@modelcontextprotocol/conformance"
  ],
  "project": [
    "app/**/*.{ts,tsx,mjs}",
    "workers/**/*.ts",
    "scripts/**/*.mjs",
    "www/*.mjs",
    "test/**/*.ts",
    "*.{ts,mjs}"
  ],
  "ignoreUnresolved": [
    "^\\./\\+types/"
  ]
}
